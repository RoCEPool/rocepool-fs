# rocepool 集群配置：复制成 cluster.conf，填好后在其中任意一台上运行 sudo ./run.sh
# （运行的那台按 RoCE IP 自动识别为“本机”，其余都是对端；台数不限）

[login]
# 各节点上一个有 sudo 权限的登录用户和它的密码（所有节点相同）。
# 只在“本机 root 还不能免密登录某台”时用一次：自动把本机 root 的公钥装到那台的 root。
# 节点之间 root 已经能免密登录的，两行都可以留空。
# 本文件含密码：run.sh 会自动改成仅 root 可读（600）；公钥装好后可以删掉密码。
# password 一行后面不要写注释（# 也算密码的一部分）。
user = admin
password =

[nodes]
# SSH 地址（管理网 IP 或主机名）   RoCE IP（数据网）   主机名（可选）
# 主机名一栏：各节点主机名有重复时（克隆出来的机器常见），按这里自动改名；不重复则不改。
10.0.0.11     10.10.0.11     node01
10.0.0.12    10.10.0.12    node02
