<?xml version="1.0" encoding="UTF-8"?>
<!-- A small JMeter plan shaped like RapidsSE's bamboo/perftest/configs/tests/*.jmx,
     for tests/test_rapidsse_tpch.py -->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.4.1">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="JDBC_URL" elementType="Argument">
            <stringProp name="Argument.name">JDBC_URL</stringProp>
            <stringProp name="Argument.value">${__P(JDBC_URL,jdbc:se://localhost:9123)}</stringProp>
          </elementProp>
          <elementProp name="QUERY_LOOP_COUNT" elementType="Argument">
            <stringProp name="Argument.name">QUERY_LOOP_COUNT</stringProp>
            <stringProp name="Argument.value">3</stringProp>
          </elementProp>
          <elementProp name="SLEEP_TIME" elementType="Argument">
            <stringProp name="Argument.name">SLEEP_TIME</stringProp>
            <stringProp name="Argument.value">2</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="JDBC Connection Configuration"/>
      <hashTree/>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown Thread Group" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="LoopController.loops">1</stringProp>
      </PostThreadGroup>
      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="dropT" enabled="true">
          <stringProp name="query">DROP TABLE t;</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="variableNames"></stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Main Thread Group" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="debugMarker" enabled="true">
          <stringProp name="script">log.info('*** Loading ***')</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="loadT" enabled="true">
          <stringProp name="query">dload t paths "/mnt/disk1/data1/t.tbl" "/mnt/disk2/data1/t.tbl";</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="countT" enabled="true">
          <stringProp name="query">SELECT COUNT(*) FROM t;</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="variableNames">tCount</stringProp>
        </JDBCSampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="assertTCount" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-1234">42</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
            <stringProp name="Assertion.scope">variable</stringProp>
            <stringProp name="Scope.variable">tCount_1</stringProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Check for failure" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(!${JMeterThread.last_sample_ok},)}</stringProp>
        </IfController>
        <hashTree/>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Queries" enabled="true"/>
        <hashTree>
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Q1 Group" enabled="true"/>
          <hashTree>
            <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Q1Loop" enabled="true">
              <stringProp name="LoopController.loops">${QUERY_LOOP_COUNT}</stringProp>
            </LoopController>
            <hashTree>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="sleep" enabled="true">
                <stringProp name="query">sleep ${SLEEP_TIME} ;</stringProp>
                <stringProp name="queryType">Update Statement</stringProp>
              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q1" enabled="true">
                <stringProp name="query">select 1;</stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
              </JDBCSampler>
              <hashTree/>
            </hashTree>
          </hashTree>
          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Q2 Group" enabled="false"/>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q2" enabled="true">
              <stringProp name="query">select 2;</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
